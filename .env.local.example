# ── Povinné pre spustenie ─────────────────────────────────────
# Supabase (service key — server-side only, obchádza RLS)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Anthropic / Claude API (story + prompt + DNA generovanie)
ANTHROPIC_API_KEY=

# App base URL (produkcia: https://<app>.vercel.app)
APP_URL=http://localhost:3000

# ── Auth pre crony a server-to-server volania ─────────────────
# POZOR: keď chýba, chránené routes sú OTVORENÉ (fail-open, fix v M1).
# Vercel crony ho posielajú automaticky ako Bearer; cron-job.org ako ?secret=
CRON_SECRET=

# ── Generovanie médií ─────────────────────────────────────────
# Google AI Studio — Nano Banana 2/Pro + Veo (PRIMÁRNY generátor)
GOOGLE_API_KEY=

# Higgsfield Cloud API — Soul V2 (intimate fallback + Fanvue sety + character sheet)
# Formát: KEY_ID:KEY_SECRET
HIGGSFIELD_API_KEY=

# fal.ai — FLUX LoRA fallback + Kling/Seedance video
FAL_API_KEY=

# BFL — Black Forest Labs (FLUX.2 multi-reference, voliteľný fallback)
BFL_API_KEY=

# ── Publikovanie ──────────────────────────────────────────────
# Instagram Graph API (posting + import-insights cron)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Instagram webhook + AI agent
# IG_APP_SECRET = Instagram app secret z Meta dashboardu
# IG_WEBHOOK_VERIFY_TOKEN = vlastný dlhý náhodný reťazec, rovnaký vo Verceli a Meta webhook nastavení
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=
# Bezpečný default: agent nič neodosiela
IG_AGENT_ENABLED=false
IG_AGENT_DRY_RUN=true
# Odosielanie DM zdieľa posting kredenciály vyššie (IG_USER_ID + DB-first token
# z getIgAccessToken, fallback IG_ACCESS_TOKEN). Voliteľná verzia Graph API:
# IG_GRAPH_API_VERSION=v23.0

# YouTube OAuth (reels) — refresh token získaš cez /api/auth/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Fanvue (monetizácia) — OAuth only, žiadne API kľúče ───────
# App vytvoríš vo Fanvue Builder area; redirect URI:
#   {APP_URL}/api/auth/fanvue/callback
# Tokeny sa po autorizácii cez /api/auth/fanvue ukladajú do DB (chs_oauth_tokens).
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# Voliteľné — default: offline_access read:self read:fan read:insights write:post write:media write:chat-message
# FANVUE_SCOPES=

# ── Creative Intelligence — AI Video Optimizer ────────────────
# Autonomous daily optimization (6:15 AM cron)
# Analýza IG analytics → generovanie production batch stratégie
# Click-to-generate workflow: Higgsfield first frame + Kling motion
# HIGGSFIELD_API_KEY a FAL_API_KEY sú už zadefinované vyššie (reuse)

# Slack notifications (voliteľné) — na /api/creative-intelligence/trigger-optimizer
SLACK_WEBHOOK_URL=

# GitHub Actions ci workflow (voliteľné)
GITHUB_ACTIONS_ENABLED=true

# ── Legacy / voliteľné ────────────────────────────────────────
# GitHub Actions dispatch (starý Higgsfield workflow; token: repo + workflow scope)
GH_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=character-studio

# ── RECOVERY sprint ───────────────────────────────────────────
# CI_SCORING_FROZEN — kill switch for the blind optimizer loop (default false).
# true  = growth_score stops steering SELECTION: archetype weighting goes uniform across the
#         whole chs_shot_archetypes pool (15), the CI preferredShotStyle nudge is ignored, and
#         the CI/growth_layer tier bias is dropped. growth_score keeps being computed + written.
# Set to true in Vercel → Settings → Environment Variables (Production) for the recovery sprint.
CI_SCORING_FROZEN=false

# ── Phase 2: reel recipes + hook overlay (všetko voliteľné, default vypnuté) ──
# true = zapne reel recepty (ootd_stop / grwm_loading) pre všetky postavy; false = kill switch.
# Inak rozhoduje character flag reel_recipes_v1. Vyžaduje SQL supabase/migrations/20261004_reel_recipes.sql
# REEL_RECIPES_ENABLED=
# true = vypáli hook text do reelu (video-async); false = kill switch. Inak character flag hook_overlay_v1.
# HOOK_OVERLAY_ENABLED=
# true = vráti pôvodných 7 reel formátov namiesto 2 receptov
# REEL_FORMATS_LEGACY=

# ── Phase 3: trending audio na reeloch (všetko voliteľné, default vypnuté) ──
# true = zapne audio cestu pre všetky postavy; false = kill switch (bez DB čítania).
# Inak rozhoduje character flag ig_trending_audio. Vyžaduje SQL supabase/migrations/20261005_post_audio.sql
# IG_TRENDING_AUDIO_ENABLED=
# Facebook Login (graph.facebook.com/v25.0) – Page token NEEXPIRUJE, ak je odvodený z dlhodobého user tokenu.
# FB_PAGE_ACCESS_TOKEN=
# alternatíva: dlhodobý user token (~60 dní), Page token sa odvodí cez me/accounts
# FB_LONG_LIVED_USER_TOKEN=
# FB_IG_USER_ID=17841420035272321
# FB_PAGE_ID=1335779962949618
# na debug_token (fb-token-health route)
# FB_APP_ID=
# FB_APP_SECRET=
# bezpečnejší režim: hľadať len v Meta Sound Collection (royalty-free), napr. "chill"
# IG_AUDIO_SEARCH_QUERY=
# Phase 7 — trending-audio test (FB path only; needs IG_TRENDING_AUDIO_ENABLED or the char flag):
#   IG_AUDIO_MODE=trending|library (default library = IG_AUDIO_SEARCH_QUERY collection, unchanged)
#   IG_AUDIO_TRENDING_UNTIL=YYYY-MM-DD (inclusive, Europe/Bratislava; after it -> library, no deploy)
#   IG_AUDIO_TRENDING_TOP_N=5 (pick randomly among the top N trending tracks, 1..25)
# IG_AUDIO_MODE=
# IG_AUDIO_TRENDING_UNTIL=
# IG_AUDIO_TRENDING_TOP_N=
# true = použiť len tracky s is_ads_eligible=true (trending hudba ich dnes takmer nemá -> väčšinou fallback bez audia)
# IG_AUDIO_REQUIRE_ADS_ELIGIBLE=
# true = pošle is_ai_generated=true v audio ceste
# IG_SET_AI_GENERATED=
